# Public values, bundled into the website. Leave the Sanity id empty to run with sample jerseys.
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
VITE_SHOP_NAME=Papa Jersey
# International format without "+" or spaces, e.g. 6281234567890
VITE_WHATSAPP_NUMBER=6281234567890
# Pre-filled printing cost for new jerseys in the admin form (Rupiah)
VITE_DEFAULT_NAMESET_PRICE=50000

# Server-only configuration. Never prefix secrets with VITE_.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2025-02-19
SANITY_WRITE_TOKEN=
# Comma-separated. Optional role after a colon: owner (default) or staff.
# staff may only change stock and show/hide.
ADMIN_USERS=owner@example.com,helper@example.com:staff
ADMIN_SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
